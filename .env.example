# Centerfield Visitor MCP — 환경변수 템플릿
#
# 사용법
#   1) cp .env.example .env
#   2) .env에 실제 값을 채웁니다 (.env는 .gitignore 대상 — 커밋되지 않음)
#   3) MCP 클라이언트 설정의 env에 CF_ENV_FILE=<이 폴더의 .env 절대경로> 지정
#      (또는 ~/.config/centerfield-visitor-mcp/.env 에 두면 모든 클라이언트가 자동으로 읽음)
#
# 우선순위: MCP 클라이언트 env > CF_ENV_FILE > ./.env > ~/.config/centerfield-visitor-mcp/.env > 기본값
# ⚠️ 이 파일(.env.example)에는 실제 전화번호를 넣지 마세요 — Git에 올라갑니다.

# [필수] 센터필드에 등록된 입주사명 (센터필드 등록 표기와 정확히 일치)
CF_COMPANY_NAME=Your Company Name

# [필수] 센터필드에 '승인 담당자'로 등록된 휴대폰 번호 ('-' 없이 숫자만)
CF_PERSON_IN_CHARGE_MOBILE=010XXXXXXXX

# 빌딩 코드 / 표시명
CF_BUILDING=east
CF_BUILDING_KEY=East

# 층 칸이 비어 있을 때 쓸 기본 층 (12 또는 18)
CF_DEFAULT_FLOOR=18

# ── 전송 방식 ────────────────────────────────────────────────
# stdio            : 로컬 에이전트 (Kiro CLI/IDE, KiroCrew, Claude Code, Codex, Cursor, Claude Desktop ...)
# streamable-http  : 원격 에이전트 (Amazon Quick 등) — 아래 CF_HTTP_* 사용
# CF_TRANSPORT=stdio
# CF_HTTP_HOST=127.0.0.1        # 컨테이너/원격 배포 시 0.0.0.0
# CF_HTTP_PORT=8000
# CF_HTTP_PATH=/mcp
# CF_HTTP_STATELESS=true
# CF_HTTP_JSON_RESPONSE=true
# CF_HTTP_ALLOWED_HOSTS=        # 비우면 DNS-rebinding 보호 끔(관리형 HTTPS 프론트 뒤에 둘 때). 예: mcp.example.com

# 파일 경로 도구(*_from_file) 노출 여부. 기본: stdio=on, streamable-http=off
# CF_EXPOSE_FILE_TOOLS=

# ── 고급 설정 (보통 수정 불필요) ─────────────────────────
# CF_CENTERFIELD_BASE_URL=https://www.centerfield.co.kr
# CF_REQUEST_TIMEOUT=30
# CF_BULK_MAX_VISITORS=200      # 원격(Quick) 배포는 10 권장 — MCP 작업당 60초 제한
# CF_REQUEST_DELAY=0.5
