{
  "mcpServers": {
    "centerfield-visitor": {
      "command": "uvx",
      "args": [
        "--from",
        "/absolute/path/to/centerfield-visitor-mcp",
        "centerfield-visitor-mcp"
      ],
      "env": {
        "CF_ENV_FILE": "/absolute/path/to/centerfield-visitor-mcp/.env"
      }
    }
  }
}
